# Integration server: server-only secrets. Never use a VITE_ prefix.
OPENAI_API_KEY=
HUMAN_MCP_TOKEN=
# Public HTTPS URL reachable by Agents API, ending with /mcp.
HUMAN_MCP_URL=
INTEGRATION_HOST=127.0.0.1
INTEGRATION_PORT=4320
LIVE_MODEL=gpt-live-1
LIVE_VOICE=shida
AGENT_MODEL=gpt-6.1-sol
# Enabled only after confirming API support with the account.
LIVE_DECISIONS_ENABLED=true
HUMAN_BRIDGE_URL=ws://127.0.0.1:4320/bridge
# Exact approved callback hostnames, comma separated; empty rejects subscriptions.
MCP_EVENT_CALLBACK_HOSTS=

# Local development: copy this file to .env.local in the repository root.
# npm run dev loads .env.local for server processes. Never use VITE_ for secrets.
