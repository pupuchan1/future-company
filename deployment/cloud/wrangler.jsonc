{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "future-company-voice-node",
  "account_id": "a35a4c201dc020caa185829b1d74acbf",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "containers": [{
    "class_name": "VoiceNode",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile", "build_context": "../.." } }
  }],
  "durable_objects": { "bindings": [{ "name": "VOICE_NODE", "class_name": "VoiceNode" }] },
  "exports": { "VoiceNode": { "type": "durable-object", "storage": "sqlite" } },
  "vars": {
    "WORKER_API_URL": "https://future-company-demo.r74.workers.dev",
    "HUMAN_MCP_URL": "https://future-company-voice-node.r74.workers.dev/mcp",
    "SLACK_CHANNEL_ID": "C0CA6A7F4E5",
    "LIVE_MODEL": "gpt-live-1"
  }
}
