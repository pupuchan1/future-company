# Put real values only in an ignored, private env file. Never in a frontend VITE_* variable.
OPENAI_API_KEY=
HUMAN_MCP_URL=https://YOUR_AUTHORIZED_RELAY_HOST/mcp
HUMAN_MCP_TOKEN=
NODE_RELAY_SECRET=
INTEGRATION_PORT=4340
NODE_RELAY_PORT=4330
INTEGRATION_STATE_DIR=.integration-state
# Set only verified, exact public callback hosts when testing real MCP Events subscriptions.
MCP_EVENT_CALLBACK_HOSTS=
# Use one explicit Worker origin. WORKER_API_URL takes precedence over WORKER_API_ORIGIN.
WORKER_API_ORIGIN=https://future-company-demo.r74.workers.dev
STAFF_API_TOKEN=
# Cloudflare Access service credentials stay on the server, never in VITE_*.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
